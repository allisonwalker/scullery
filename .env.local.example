# Supabase — get these from your project's Settings > API page
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Seed script test credentials (used by scripts/seed.ts only)
SEED_USER1_EMAIL=user1@example.com
SEED_USER1_PASSWORD=TestPassword1!
SEED_USER2_EMAIL=user2@example.com
SEED_USER2_PASSWORD=TestPassword2!
